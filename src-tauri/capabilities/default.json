{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The settings window (main), which also shows onboarding (M5.2): the app's own commands and nothing else. No core: permissions; the tray, menus and windows are driven from Rust. Kept in sync with src-tauri/src/command_names.rs by a test.",
  "windows": ["main"],
  "permissions": [
    "allow-get-settings",
    "allow-save-settings",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-test-api-key",
    "allow-get-onboarding",
    "allow-request-permission",
    "allow-open-setup",
    "allow-set-onboarding-step",
    "allow-finish-onboarding",
    "allow-relaunch-app",
    "allow-list-local-models",
    "allow-download-local-model",
    "allow-cancel-local-model-download",
    "allow-delete-local-model",
    "allow-set-share-usage-events",
    "allow-set-hotkey",
    "allow-set-hotkey-recording",
    "allow-get-hotkey-notice",
    "allow-set-launch-at-login",
    "allow-run-checks",
    "allow-test-connection",
    "allow-build-report",
    "allow-save-report",
    "allow-open-issue",
    "allow-take-window-request",
    "allow-reveal-log-file",
    "allow-dictation-progress",
    "allow-launch-notice",
    "allow-set-language",
    "allow-use-cloud-engine",
    "allow-use-local-model",
    "allow-get-engine-status",
    "allow-delete-api-key",
    "allow-start-microphone-test",
    "allow-read-microphone-test",
    "allow-stop-microphone-test",
    "allow-open-link",
    "allow-get-app-info",
    "allow-check-for-updates",
    "allow-choose-local-model",
    "allow-set-try-outcome",
    "allow-practice-paste-missed",
    "allow-set-download-paused",
    "allow-practice-words",
    "allow-copy-practice-words",
    "allow-set-speech-choice",
    "allow-leave-setup-for-settings",
    "allow-list-history",
    "allow-copy-history-entry",
    "allow-delete-history-entry",
    "allow-clear-history",
    "allow-set-history-limit"
  ]
}
