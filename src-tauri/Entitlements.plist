<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundle is signed with the hardened runtime, which refuses the
	     microphone without this entitlement: no prompt, just "denied".
	     This is the only one, on purpose. docs/releasing.md says why each of
	     the others was left out, and scripts/test-release.sh and
	     scripts/release.sh fail if this list changes without that. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
