{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vocet",
  "mainBinaryName": "Vocet",
  "version": "0.1.0",
  "identifier": "com.dictationapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vocet Settings",
        "width": 720,
        "height": 520,
        "minWidth": 640,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "dictation-app Dev",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/gargankit90/dictation-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QzgwRjE3M0E5NkQ3OEYKUldTUDE1WTZGdy9JOWpxTlNIUjA4ampTb2pSdkFHdENZVjA4TEtBSkkwVW5zNHFTZkNmSURRWHAK",
      "requireSignedVersion": true
    }
  }
}
