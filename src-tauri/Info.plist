<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A menu-bar app: no Dock icon and no app menu (accessory activation
	     policy). Tauri merges this into the bundle's Info.plist. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Shown in the microphone permission prompt. Without it macOS kills
	     the app the moment it asks for the microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>dictation-app records your voice while you hold the dictation hotkey, to turn it into text.</string>
</dict>
</plist>
