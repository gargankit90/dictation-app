#!/usr/bin/env bash
# Run by git's pre-push hook (installed by scripts/install-hooks.sh) after the
# hook has run its own installed copy of the push guard, if this checkout has
# this file. Runs this checkout's push guard, then the quality gate (lefthook's
# pre-push-gate hook, which runs scripts/gate.sh). Fails closed if lefthook is
# missing.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
refs=$(cat)

printf '%s\n' "$refs" | "$root/scripts/guard-push.sh" "$@"
cd "$root"
lefthook run pre-push-gate
